{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulnerabilityBountyProgram",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the program (slug)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the vulnerability program"
    },
    "organization": {
      "type": "string",
      "description": "Entity or organization offering the program"
    },
    "platform": {
      "type": "string",
      "enum": ["HackerOne", "Bugcrowd", "Intigriti", "YesWeHack", "Immunefi", "HackenProof", "OpenBugBounty", "Direct / Self-Hosted", "Other"],
      "description": "Platform hosting the program"
    },
    "program_type": {
      "type": "string",
      "enum": ["Bug Bounty", "VDP (Unpaid)", "Grant", "RFP"],
      "description": "Type of vulnerability engagement"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Primary landing URL of the program"
    },
    "policy_url": {
      "type": ["string", "null"],
      "description": "URL to full rules and disclosure policy"
    },
    "max_bounty_usd": {
      "type": ["number", "null"],
      "description": "Maximum reward in USD, null if unpaid or undisclosed"
    },
    "min_bounty_usd": {
      "type": ["number", "null"],
      "description": "Minimum reward in USD"
    },
    "reward_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of rewards offered (Cash, Swag, Hall of Fame, Tokens)"
    },
    "scope_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of domains, IP ranges, or repos in scope"
    },
    "out_of_scope_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Excluded domains or attack types"
    },
    "contact_email": {
      "type": ["string", "null"],
      "description": "Primary contact email address for disclosures"
    },
    "security_txt_url": {
      "type": ["string", "null"],
      "description": "URL to RFC 9116 security.txt if available"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags (e.g. Web, Mobile, Cloud, Smart Contracts, Hardware)"
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Paused", "Deprecated"],
      "description": "Current status of the program"
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 timestamp of last verification"
    }
  },
  "required": ["id", "name", "organization", "platform", "program_type", "url", "status"]
}
